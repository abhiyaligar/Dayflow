# Dayflow HRMS Backend Environment Configuration

# App Mode (development, production)
APP_ENV=development

# Database Settings (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dayflow_db

# Security & JWT Credentials
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_hex_encoded_key_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin/HR User Configuration (for seeding)
INITIAL_ADMIN_EMAIL=admin@dayflow.com
INITIAL_ADMIN_PASSWORD=SecurePassword123!
INITIAL_ADMIN_ID=DF-2026-0001

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@dayflow.com
SMTP_FROM_NAME="Dayflow HRMS"
SMTP_STARTTLS=true
SMTP_SSL=false

